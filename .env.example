# Set on Vercel (not a VITE_ variable); public HTTPS origin of the Java service.
TASK_API_ORIGIN=https://your-java-backend.example.com

# For running the Java backend; do not put real credentials in this example.
AI_BASE_URL=https://your-ai-provider.example.com/v1
AI_MODEL=your-model-name
AI_API_KEY=
# Use a writable persistent volume on the Java host.
TASKMANAGEMENT_DB=/app/data/tasks.db
